<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="cl.bennu.controljornadabackend.mapper.JustificationMapper">

    <resultMap id="justificationMap" type="cl.bennu.controljornadabackend.model.Justification">
        <id property="id" column="id"/>
        <result property="comments" column="comments"/>
        <result property="attachment" column="attachment"/>
        <result property="justificationTypeId" column="justification_type_id"/>
    </resultMap>

    <sql id="sqlJustification">
        SELECT
            j.id
            , j.comments
            , j.attachment
            , j.justification_type_id
        FROM justification j
    </sql>

    <select id="getAll" resultMap="justificationMap">
        <include refid="sqlJustification"/>
    </select>

    <select id="get" resultMap="justificationMap" parameterType="java.lang.Long">
        <include refid="sqlJustification"/>
        WHERE j.id = #{id}
    </select>

    <insert id="insert" parameterType="cl.bennu.controljornadabackend.model.Justification" keyProperty="id" keyColumn="id" useGeneratedKeys="true">
        INSERT INTO justification (
            comments
            , attachment
            , justification_type_id
        ) VALUES (
            #{comments,jdbcType=VARCHAR}
            , #{attachment,jdbcType=BINARY}
            , #{justificationTypeId}
        )
    </insert>

    <update id="update" parameterType="cl.bennu.controljornadabackend.model.Justification">
        UPDATE justification SET
            comments = #{comments,jdbcType=VARCHAR}
            , attachment = #{attachment,jdbcType=BINARY}
            , justification_type_id = #{justificationTypeId}
        WHERE id = #{id}
    </update>

    <delete id="delete" parameterType="java.lang.Long">
        DELETE FROM justification WHERE id = #{id}
    </delete>

</mapper>
