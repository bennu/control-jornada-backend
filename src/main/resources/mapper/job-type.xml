<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="cl.bennu.controljornadabackend.mapper.JobTypeMapper">

    <resultMap id="jobTypeMap" type="cl.bennu.controljornadabackend.model.JobType">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <association property="company" javaType="cl.bennu.controljornadabackend.model.Company">
            <id property="id" column="company_id"/>
            <result property="name" column="company_name"/>
        </association>
        <association property="branch" javaType="cl.bennu.controljornadabackend.model.Branch">
            <id property="id" column="branch_id"/>
            <result property="name" column="branch_name"/>
        </association>
    </resultMap>

    <sql id="sqlJobType">
        SELECT
            jt.id
            , jt.name
            , jt.company_id
            , jt.branch_id
            , c.name AS company_name
            , b.name AS branch_name
        FROM job_type jt
        LEFT JOIN company c ON c.id = jt.company_id
        LEFT JOIN branch b ON b.id = jt.branch_id
    </sql>

    <select id="getAll" resultMap="jobTypeMap">
        <include refid="sqlJobType"/>
    </select>

    <select id="get" resultMap="jobTypeMap" parameterType="java.lang.Long">
        <include refid="sqlJobType"/>
        WHERE jt.id = #{id}
    </select>

    <insert id="insert"
            parameterType="cl.bennu.controljornadabackend.model.JobType"
            keyProperty="id"
            useGeneratedKeys="true">
        INSERT INTO job_type (
            name
            , company_id
            , branch_id
        ) VALUES (
            #{name}
            , #{company.id}
            , #{branch.id}
        )
    </insert>

    <update id="update" parameterType="cl.bennu.controljornadabackend.model.JobType">
        UPDATE job_type SET
            name = #{name}
            , company_id = #{company.id}
            , branch_id = #{branch.id}
        WHERE id = #{id}
    </update>

    <delete id="delete">
        DELETE FROM job_type WHERE id = #{id}
    </delete>

</mapper>
