<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="cl.bennu.controljornadabackend.mapper.ContractTypeMapper">

    <resultMap id="contractTypeMap" type="cl.bennu.controljornadabackend.model.ContractType">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
    </resultMap>

    <sql id="sqlContractType">
        SELECT
            ct.id
            , ct.name
        FROM contract_type ct
    </sql>

    <select id="getAll" resultMap="contractTypeMap">
        <include refid="sqlContractType"/>
    </select>

    <select id="get" resultMap="contractTypeMap" parameterType="java.lang.Long">
        <include refid="sqlContractType"/>
        WHERE ct.id = #{id}
    </select>

    <insert id="insert" parameterType="cl.bennu.controljornadabackend.model.ContractType">
        INSERT INTO contract_type (
            id
            , name
        ) VALUES (
            #{id}
            , #{name}
        )
    </insert>

    <update id="update" parameterType="cl.bennu.controljornadabackend.model.ContractType">
        UPDATE contract_type SET
            name = #{name}
        WHERE id = #{id}
    </update>

    <delete id="delete">
        DELETE FROM contract_type WHERE id = #{id}
    </delete>

</mapper>
