<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="cl.bennu.controljornadabackend.mapper.CountryMapper">

    <!-- ******************************  -->
    <!-- Columnas de tabla y atributos de clases -->
    <!-- ******************************  -->
    <resultMap id="countryMap" type="cl.bennu.controljornadabackend.model.Country">
        <id     property="id"           column="id"/>
        <result property="name"         column="name"/>
        <result property="nationality"  column="nationality"/>
    </resultMap>



    <!-- ******************************  -->
    <!-- Operaciones CRUD -->
    <!-- ******************************  -->
    <sql id="sqlCountry">
        SELECT
            c.id,
            c.name,
            c.nationality
        FROM country c
    </sql>

    <select id="getAll" resultMap="countryMap">
        <include refid="sqlCountry"/>
    </select>

    <select id="get" resultMap="countryMap"
            parameterType="java.lang.Long"
    >
        <include refid="sqlCountry"/>
        WHERE c.id = #{id}
    </select>


    <insert id="insert"
            parameterType="cl.bennu.controljornadabackend.model.Country"
    >
        INSERT INTO country (
            name,
            nationality
        )
        VALUES (
            #{name},
            #{nationality}
        )
    </insert>


    <update id="update"
            parameterType="cl.bennu.controljornadabackend.model.Country">
        UPDATE country SET
            name = #{name},
            nationality = #{nationality}
        WHERE id = #{id}
    </update>

    <delete id="delete">
        DELETE FROM country
        WHERE id = #{id}
    </delete>

</mapper>
