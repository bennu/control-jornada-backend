<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="cl.bennu.controljornadabackend.mapper.CityMapper">

    <resultMap id="cityMap" type="cl.bennu.controljornadabackend.model.City">
        <id property="id" column="id"/>
        <result property="name" column="name"/>

        <association property="region" javaType="cl.bennu.controljornadabackend.model.Region">
            <id property="id" column="region_id"/>
            <result property="name" column="region_name"/>
        </association>
    </resultMap>

    <sql id="sqlCity">
        <!-- @formatter:off -->
        SELECT
        c.id
        , c.name
        , c.region_id
        , r.name AS region_name
        FROM city c
        INNER JOIN region r ON r.id = c.region_id
        <!-- @formatter:on -->
    </sql>

    <select id="getAll" resultMap="cityMap">
        <include refid="sqlCity"/>
    </select>

    <select id="get" resultMap="cityMap" parameterType="java.lang.Long">
        <include refid="sqlCity"/>
        WHERE c.id = #{id}
    </select>

    <!-- id es INTEGER (no SERIAL): se calcula con MAX(id)+1 -->
    <insert id="insert" parameterType="cl.bennu.controljornadabackend.model.City" keyProperty="id" useGeneratedKeys="true">
        <!-- @formatter:off -->
        INSERT INTO city (
        id
        , region_id
        , name
        ) VALUES (
        (SELECT COALESCE(MAX(id), 0) + 1 FROM city)
        , #{region.id}
        , #{name}
        )
        <!-- @formatter:on -->
    </insert>

    <update id="update" parameterType="cl.bennu.controljornadabackend.model.City">
        <!-- @formatter:off -->
        UPDATE city SET
        region_id = #{region.id}
        , name = #{name}
        WHERE id = #{id}
        <!-- @formatter:on -->
    </update>

    <delete id="delete">
        DELETE FROM city WHERE id = #{id}
    </delete>

</mapper>
