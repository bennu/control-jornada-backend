<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="cl.bennu.controljornadabackend.mapper.BranchMapper">

    <resultMap id="branchMap" type="cl.bennu.controljornadabackend.model.Branch">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="address" column="address"/>
        <result property="phone" column="phone"/>
        <result property="alias" column="alias"/>
        <result property="active" column="active"/>
        <association property="company" javaType="cl.bennu.controljornadabackend.model.Company">
            <id property="id" column="company_id"/>
            <result property="name" column="company_name"/>
        </association>
        <association property="commune" javaType="cl.bennu.controljornadabackend.model.Commune">
            <id property="id" column="commune_id"/>
            <result property="name" column="commune_name"/>
        </association>
    </resultMap>

    <sql id="sqlBranch">
        SELECT
            b.id
            , b.company_id
            , b.commune_id
            , c.name AS company_name
            , cm.name AS commune_name
            , b.name
            , b.address
            , b.phone
            , b.alias
            , b.active
        FROM branch b
        LEFT JOIN company c ON c.id = b.company_id
        LEFT JOIN commune cm ON cm.id = b.commune_id
    </sql>

    <select id="getAll" resultMap="branchMap">
        <include refid="sqlBranch"/>
    </select>

    <select id="get" resultMap="branchMap" parameterType="java.lang.Long">
        <include refid="sqlBranch"/>
        WHERE b.id = #{id}
    </select>

    <insert id="insert"
            parameterType="cl.bennu.controljornadabackend.model.Branch"
            keyProperty="id"
            useGeneratedKeys="true">
        INSERT INTO branch (
            company_id
            , commune_id
            , name
            , address
            , phone
            , alias
            , active
        ) VALUES (
            #{company.id}
            , #{commune.id}
            , #{name}
            , #{address}
            , #{phone}
            , #{alias}
            , #{active}
        )
    </insert>

    <update id="update" parameterType="cl.bennu.controljornadabackend.model.Branch">
        UPDATE branch SET
            company_id = #{company.id}
            , commune_id = #{commune.id}
            , name = #{name}
            , address = #{address}
            , phone = #{phone}
            , alias = #{alias}
            , active = #{active}
        WHERE id = #{id}
    </update>

    <delete id="delete">
        DELETE FROM branch WHERE id = #{id}
    </delete>

</mapper>
